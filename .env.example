# Copy this file to .env and adjust. The values below are the defaults baked
# into the Docker image, where paths are container paths.
#
# With docker run:
#   docker run --rm -p 8099:8099 --env-file .env \
#     -v /srv/capforge/caps:/home/capforge/.agents/skills \
#     -v /srv/capforge/state:/var/lib/capforge \
#     capforge
#
# The caps volume must be the SAME folder Open WebUI's terminal scans for
# skills (~/.agents/skills under the terminal home, or .cptr/.claude/.codex),
# otherwise capabilities will not appear in the model's per-turn manifest.
# Mounted host folders must be writable by UID 10001 (the image user):
#   sudo chown -R 10001:10001 /srv/capforge/caps /srv/capforge/state

# Folder the model edits; the draft of every capability lives here.
CAPFORGE_CAPS_DIR=/home/capforge/.agents/skills

# Versions, per-capability venvs, per-version data and state JSON.
# Give this its own volume: it is the part you must not lose.
CAPFORGE_STATE_DIR=/var/lib/capforge

# Tags kept per capability. The active tag is never pruned.
CAPFORGE_KEEP_TAGS=5

# Hard limits, in seconds.
CAPFORGE_RUN_TIMEOUT=120
CAPFORGE_TEST_TIMEOUT=300
CAPFORGE_INSTALL_TIMEOUT=240

# MCP transport. `http` is FastMCP's streamable HTTP endpoint.
CAPFORGE_HOST=0.0.0.0
CAPFORGE_PORT=8099
CAPFORGE_PATH=/mcp
CAPFORGE_TRANSPORT=http

# There are deliberately no credential variables here. Capability environments
# are filtered to PATH/locale/SSL/pip-index settings only, and secrets must be
# terminated at a proxy in front of the server if they are needed at all.
