# Copy this file to .env and adjust. Paths are container paths.
#
# Capabilities are git repositories. The caps directory is server-owned; the
# model clones a repository, edits its own copy, and pushes. There is no shared
# terminal skills mount.
#
# docker run:
#   docker run --rm -p 8099:8099 -p 8080:8080 --env-file .env \
#     -v /srv/capforge/caps:/var/lib/capforge/caps \
#     -v /srv/capforge/state:/var/lib/capforge/state \
#     capforge
#
# The entrypoint chowns the mounted caps/state directories; set PUID/PGID to
# their host owner. Rootless Docker / --user must pre-chown instead:
#   sudo chown -R "$(id -u):$(id -g)" /srv/capforge/caps /srv/capforge/state

PUID=10001
PGID=10001

# Drafts, materialised pushes and the bare repositories.
CAPFORGE_CAPS_DIR=/var/lib/capforge/caps

# Versions, venvs, data, logs, staging state, repos and locks. Own volume; back
# it up. It must not be shared with the terminal.
CAPFORGE_STATE_DIR=/var/lib/capforge/state

# Git tokens for clone/push. One token grants both for one capability.
CAPFORGE_GIT_TOKEN_TTL=600
CAPFORGE_MAX_UPLOAD_BYTES=67108864

# Tags kept per capability. The active tag is never pruned.
CAPFORGE_KEEP_TAGS=5

# Hard limits, in seconds.
CAPFORGE_RUN_TIMEOUT=120
CAPFORGE_TEST_TIMEOUT=300
CAPFORGE_INSTALL_TIMEOUT=240
CAPFORGE_SERVE_BOOT_TIMEOUT=60
CAPFORGE_GIT_TIMEOUT=300

# Landlock filesystem confinement for capability and web children. git and uv
# children are tracked but not yet confined.
# require: fail closed if the kernel lacks Landlock; warn: log and run
# unrestricted; off: explicit, not for production.
CAPFORGE_SANDBOX=require

# Bounded diagnostics returned through staging(action="logs") and
# serve_capability(action="logs").
CAPFORGE_LOG_MAX_BYTES=1048576
CAPFORGE_LOG_TAIL_BYTES=65536

# Web listener: /ui console, /api control, /git smart HTTP, /cap/<name>/ proxy.
# Port 0 disables the whole listener (and therefore console, clone/push and serving).
CAPFORGE_WEB_HOST=0.0.0.0
CAPFORGE_WEB_PORT=8080

# Console/control-API token (/api/*). Long random string; never exposed. UNSET
# disables the console while /cap/ and /git/ keep working.
# CAPFORGE_WEB_TOKEN=

# Serve the built console bundle (1) or the JSON index (0).
CAPFORGE_WEB_UI=1
CAPFORGE_UI_DIR=/app/ui/dist

# Externally reachable base, including any reverse-proxy prefix. TLS must
# terminate in front for git and the console.
# CAPFORGE_PUBLIC_URL=https://tools.example.com

# MCP transport. `http` is FastMCP's streamable HTTP endpoint.
CAPFORGE_HOST=0.0.0.0
CAPFORGE_PORT=8099
CAPFORGE_PATH=/mcp
CAPFORGE_TRANSPORT=http

# Required for HTTP MCP transport. Send it as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
CAPFORGE_MCP_TOKEN=

CAPFORGE_LOG_LEVEL=INFO

# There are no credential variables for capability code in this file. Capabilities
# declare fields on the pydantic Env model in deploy.py; the operator sets values in
# the console (CAPFORGE_WEB_TOKEN required above). Values are stored under the state
# volume in <state>/secrets/ with mode 0600. Environments are otherwise filtered to
# PATH/locale/SSL; uv index settings are installer-only.
#
# Served web children also receive CAPFORGE_ROOT_PATH=/cap/<name> and uvicorn
# --root-path. Capforge injects both per child; do not set them here.
