# Copy this file to .env and adjust. The values below are the defaults baked
# into the Docker image, where paths are container paths.
#
# With docker run:
#   docker run --rm -p 8099:8099 -p 8080:8080 --env-file .env \
#     -v /srv/capforge/caps:/home/capforge/.agents/skills \
#     -v /srv/capforge/state:/var/lib/capforge \
#     capforge
#
# The caps volume must be the SAME folder Open WebUI's terminal scans for
# skills (~/.agents/skills under the terminal home, or .cptr/.claude/.codex),
# otherwise capabilities will not appear in the model's per-turn manifest.
# The entrypoint chowns the mounted caps/state directories, so set PUID/PGID to
# their host owner. Rootless Docker / `--user` must pre-chown instead:
#   sudo chown -R "$(id -u):$(id -g)" /srv/capforge/caps /srv/capforge/state

# With docker compose, host paths are set separately (they are not container
# variables):
#   CAPFORGE_CAPS_HOST=/srv/capforge/caps
#   CAPFORGE_STATE_HOST=/srv/capforge/state
# The paths below are container paths and are set explicitly by the compose file.

# Container user. The entrypoint remaps capforge to PUID/PGID, chowns the
# mounts, then drops privileges. Set these to the host owner:
#   PUID=$(id -u) PGID=$(id -g)
PUID=10001
PGID=10001

# Folder the model edits; the draft of every capability lives here.
CAPFORGE_CAPS_DIR=/home/capforge/.agents/skills

# Versions, per-capability venvs, per-version data and state JSON.
# Give this its own volume: it is the part you must not lose.
CAPFORGE_STATE_DIR=/var/lib/capforge

# Tags kept per capability. The active tag is never pruned.
CAPFORGE_KEEP_TAGS=5

# Hard limits, in seconds.
CAPFORGE_RUN_TIMEOUT=120
CAPFORGE_TEST_TIMEOUT=300
CAPFORGE_INSTALL_TIMEOUT=240
# Budget for a kind: web capability to bind its port and answer HTTP, used by
# both the promotion gate and serve_capability start.
CAPFORGE_SERVE_BOOT_TIMEOUT=60

# Web listener: reverse proxy at /<name>/ for kind: web capabilities plus the
# console at the root. Port 0 disables the whole listener (no proxy, no
# console, serve_capability then refuses to start instances).
CAPFORGE_WEB_HOST=0.0.0.0
CAPFORGE_WEB_PORT=8080

# Access token for the console and its control API (/api/*). Long random
# string, set by the operator, never exposed through any API or log. UNSET
# means the console and control API are disabled; the capability proxy keeps
# working, and that is the safe default when the port is exposed.
# CAPFORGE_WEB_TOKEN=

# Serve the built console bundle (1) or the JSON index (0). The bundle ships
# in the Docker image at /app/ui/dist; locally it is ui/dist after
# `cd ui && bun install && bun run build`.
CAPFORGE_WEB_UI=1
# Override the bundle location (Docker image default shown).
CAPFORGE_UI_DIR=/app/ui/dist

# How the served app computes its public URL (optional). Unset, it is
# http://<web host or 127.0.0.1>:<web port>/<name>/. Set it when there is a
# reverse proxy in front, e.g. https://tools.example.com/caps/<name>/.
# CAPFORGE_PUBLIC_URL=

# Install the generated `_capforge` guide skill in the caps root on startup.
# It appears in the model's per-turn skill manifest; set 0 to disable.
CAPFORGE_GUIDE=1

# MCP transport. `http` is FastMCP's streamable HTTP endpoint.
CAPFORGE_HOST=0.0.0.0
CAPFORGE_PORT=8099
CAPFORGE_PATH=/mcp
CAPFORGE_TRANSPORT=http

# Server log verbosity (DEBUG, INFO, WARNING, ERROR). Runs and promotions are
# logged at INFO; set DEBUG for path-level detail.
CAPFORGE_LOG_LEVEL=INFO

# There are deliberately no credential variables here. Capability environments
# are filtered to PATH/locale/SSL settings only; pip index settings are visible
# to the installer, never to capability code. Secrets must be terminated at a
# proxy in front of the server if they are needed at all.
